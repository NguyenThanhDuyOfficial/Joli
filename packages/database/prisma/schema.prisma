generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  orders           Order[]
  productLoves     ProductLove[]
  sessions         Session[]
  accounts         Account[]
  checkoutSessions CheckoutSession[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  starRating  Decimal  @default(0) @map("star_rating") @db.Decimal(4, 2)
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variants   ProductVariant[]
  categories ProductCategory[]
  tags       ProductTag[]
  loves      ProductLove[]
  orderItems OrderItem[]

  @@index([slug])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  size      String?
  color     String?
  price     Int
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  images ProductImage[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  variantId String   @map("variant_id")
  url       String
  alt       String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  variant              ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  checkoutSessionItems CheckoutSessionItem[]

  @@index([variantId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Category {
  id        String   @id @default(cuid())
  parentId  String?  @map("parent_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products ProductCategory[]

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  @@index([slug])
  @@map("categories")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products ProductTag[]

  @@map("tags")
}

model ProductLove {
  userId    String @map("user_id")
  productId String @map("product_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("product_loves")
}

enum CheckoutSessionStatus {
  DRAFT
  CONVERTED
  EXPIRED
  CANCELLED
}

model CheckoutSessionItem {
  id             String @id @default(cuid())
  sessionId      String
  productId      String
  variantId      String
  productImageId String

  name      String
  unitPrice Int
  quantity  Int
  subTotal  Int

  session CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  image   ProductImage    @relation(fields: [productImageId], references: [id])

  @@unique([sessionId, variantId])
  @@index([sessionId])
  @@map("checkout_session_item")
}

model CheckoutSession {
  id      String  @id @default(cuid())
  userId  String
  orderId String? @unique

  subTotal  Int
  total     Int?
  status    CheckoutSessionStatus @default(DRAFT)
  expiresAt DateTime

  user  User                  @relation(fields: [userId], references: [id])
  order Order?                @relation(fields: [orderId], references: [id])
  items CheckoutSessionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, orderId, status])
  @@index([expiresAt])
  @@map("checkout_session")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  BANK_TRANSFER
}

model Order {
  id     String @id @default(cuid())
  userId String @map("user_id")
  code   String @unique

  status        OrderStatus   @default(PENDING)
  subTotal      Int
  shippingFee   Int           @default(0) @map("shipping_fee")
  total         Int
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  shippingName  Strng

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  user            User             @relation(fields: [userId], references: [id])
  shipping        Shipping?        @relation(fields: [shippingId], references: [id])
  checkoutSession CheckoutSession?

  @@index([userId])
  @@index([code])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  variantId String @map("variant_id")
  name      String
  imageUrl  String @map("image_url")
  price     Int
  quantity  Int
  subtotal  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Shipping {
  id      String  @id @default(cuid())
  name    String
  phone   String
  address String
  note    String?

  order Order?

  @@map("shippings")
}

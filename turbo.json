{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "format": { "dependsOn": ["^format"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "cache": false, "persistent": true },
    "generate": {},
    "seed": {},
    "migrate:dev": { "persistent": true },
    "migrate:reset": {},
    "migrate:deploy": {},
    "test:migrate:dev": {},
    "test:migrate:reset": {},
    "migrate:test": {},
    "test": {},
    "test:e2e": {},
    "prepare": {},
    "contract:emit": {},
    "test:coverage": {},
    "test:watch": {}
  }
}

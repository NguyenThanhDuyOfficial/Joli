    "db:migrate:dev": "turbo migrate:dev && pnpm db:test:migrate:dev",
    "db:migrate:test": "turbo migrate:test",
    "db:migrate:reset": "turbo migrate:reset",
    "db:migrate:deploy": "turbo migrate:deploy",
    "db:test:migrate:dev": "turbo test:migrate:dev",
    "db:test:migrate:reset": "turbo test:migrate:test",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",

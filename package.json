    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nguyenthanhduyofficial/eslint-config": "workspace:*",
    "@nguyenthanhduyofficial/typescript-config": "workspace:*",

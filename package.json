  "private": true,
  "scripts": {
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run generate",
    "db:seed": "turbo run seed",
    "db:migrate:dev": "turbo run migrate:dev && pnpm db:test:migrate:dev",
    "db:migrate:reset": "turbo run migrate:reset",
    "db:migrate:deploy": "turbo run migrate:deploy",
    "db:test:migrate:dev": "turbo run test:migrate:dev",
    "db:test:migrate:reset": "turbo run test:migrate:test",
    "db:migrate:test": "turbo run migrate:test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "contract:emit": "turbo run contract:emit",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nguyenthanhduyofficial/eslint-config": "workspace:*",
    "@nguyenthanhduyofficial/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "turbo": "^2.9.6",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  }
}

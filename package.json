    "contract:emit": "turbo contract:emit",
    "test:coverage": "turbo test:coverage",
    "test:watch": "turbo test:watch"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"

    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "turbo": "^2.9.6",
    "vitest": "^4.1.11"
